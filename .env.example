# Smart Resume AI - Environment Configuration
# Copy this file to .env.local to configure API keys.

# ==============================================================================
# 1. Session Security (Mandatory in Staging & Production: minimum 32 random chars)
# ==============================================================================
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ==============================================================================
# 2. Google Gemini API (Required for live Gemini 3.5 Flash; deterministic fallback if unset)
# ==============================================================================
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# ==============================================================================
# 3. Database Configuration
# ==============================================================================
# Local development defaults to SQLite (data/smart_resume.db).
# For Neon PostgreSQL on Vercel, configure DATABASE_URL or POSTGRES_URL with ?sslmode=require:
# Staging MUST use an isolated Neon branch pooled endpoint:
DATABASE_URL="postgresql://username:password@ep-staging-branch-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL="postgresql://username:password@ep-staging-branch-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DB_PROVIDER: "sqlite" (default local) or "postgres" (staging & production)
DB_PROVIDER="postgres"

# ==============================================================================
# 4. Staging Safety Guards (Mandatory for remote staging migration/initialization)
# ==============================================================================
# Target environment must be explicitly declared as staging to prevent accidental production touches
TARGET_DB_ENV="staging"
CONFIRM_STAGING_TARGET="staging"

# ==============================================================================
# 5. Job Search APIs (Optional for extended job feeds)
# ==============================================================================
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=

# ==============================================================================
# 6. Administrator Account Seeding (Optional for initial bootstrap)
# ==============================================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=
